---
import Icon from '../DemoIcon.astro';
import {sampleProducts,sampleCustomers} from '../../data/business-demo';
import type {Locale} from '../../data/catalog';
const {locale,id}=Astro.props as {locale:Locale;id:string};
const es=locale==='es',erp=id==='openmultipos',l=(a:string,b:string)=>es?a:b;
const name=erp?'OpenMultiPOS':'EasyDrink';
const nav=[['home','home',l('Inicio','Home')],['sales','cart',l(erp?'Ventas':'Caja',erp?'Sales':'Checkout')],['inventory','box',l(erp?'Inventario':'Productos',erp?'Inventory':'Products')],['customers','users',l('Clientes','Customers')],['reports','chart',l(erp?'Finanzas':'Reportes',erp?'Finances':'Reports')],['settings','settings',l('Ajustes','Settings')]];
const products=sampleProducts(locale).filter(p=>erp||p.brand==='a');
const customers=sampleCustomers(locale);
---
<div class:list={['business-app',erp?'erp-app':'pos-app']}>
 <aside class="business-sidebar"><a class="business-brand" href="#home"><Icon name={erp?'home':'cart'}/><span>{name}</span></a><p class="nav-caption">{l('ESPACIO DE TRABAJO','WORKSPACE')}</p><nav class="business-nav" aria-label={l('Módulos','Modules')}>{nav.map(([key,icon,label])=><a data-nav={key} href={`#${key}`}><Icon name={icon}/><span>{label}</span></a>)}</nav><div class="business-profile"><span class="avatar">AD</span><div><strong>{l('Administrador demo','Demo administrator')}</strong><small>{l('Sesión de muestra','Sample session')}</small></div></div></aside>
 <div class="business-shell">
  <div class="business-topbar"><div class="business-context">{erp?<label>{l('Negocio activo','Active business')}<select id="business-picker"><option value="a">{l('Café Aurora · Ejemplo','Aurora Café · Sample')}</option><option value="b">{l('Nexo Estudio · Ejemplo','Nexo Studio · Sample')}</option></select></label>:<div><small>{l('UN BUEN DÍA PARA TU NEGOCIO','A GOOD DAY FOR YOUR BUSINESS')}</small><strong>{l('Café Aurora · Demostración','Aurora Café · Demo')}</strong></div>}</div><span class="workspace-badge"><span class="demo-dot"></span>{l('Entorno de muestra','Sample workspace')}</span></div>
  <main id="demo-main" class="business-main">
   <section data-screen="home"><div class="screen-heading"><div><p class="overline">{l('TU NEGOCIO, DE UN VISTAZO','YOUR BUSINESS AT A GLANCE')}</p><h1>{l(erp?'Inicio':'Todo bajo control',erp?'Overview':'Everything under control')}</h1><p class="muted">{l('Explora una jornada de ejemplo y conoce tu espacio de trabajo.','Explore a sample business day and get to know your workspace.')}</p></div><a class="primary button-link" data-nav="sales" href="#sales"><Icon name="plus"/>{l('Nueva venta','New sale')}</a></div>
    <div class="metrics"><article class="metric metric-featured"><span>{l('Ventas del día de muestra','Sample day sales')}</span><strong data-metric="revenue"></strong><small data-metric="transactions"></small><Icon name="chart" size={30}/></article><article class="metric"><span>{l('Productos disponibles','Available products')}</span><strong data-metric="products"></strong><small>{l('Catálogo de demostración','Demo catalog')}</small><Icon name="box" size={30}/></article><article class="metric"><span>{l('Existencias bajas','Low stock')}</span><strong data-metric="low"></strong><small>{l('Unidades por reponer en el ejemplo','Items to restock in the example')}</small><Icon name="receipt" size={30}/></article></div>
    <div class="quick-actions">{[['sales','cart',l('Abrir caja','Open checkout')],['inventory','box',l('Ver productos','View products')],['reports','chart',l('Consultar informes','View reports')]].map(([key,icon,label])=><a href={`#${key}`} data-nav={key}><span class="quick-icon"><Icon name={icon} size={26}/></span><strong>{label}</strong><Icon name="arrow"/></a>)}</div>
    <div class="business-columns"><article class="surface"><div class="section-title"><h2>{l('Ventas recientes','Recent sales')}</h2><a href="#reports">{l('Ver todas','View all')} →</a></div><div id="recent-sales"></div></article><article class="surface stock-summary"><span class="soft-icon"><Icon name="box" size={30}/></span><h2>{l('Un catálogo listo para explorar','A catalog ready to explore')}</h2><p class="muted">{l('Busca productos, prepara una cesta y descubre cómo se presenta cada venta. Todos los importes son ficticios.','Find products, build a basket and discover how each sale is presented. All amounts are fictional.')}</p><a href="#sales" class="secondary button-link">{l('Probar una venta','Try a sale')} →</a></article></div>
   </section>
   <section data-screen="sales" hidden><div class="screen-heading"><div><p class="overline">{l('PUNTO DE VENTA','POINT OF SALE')}</p><h1>{l(erp?'Registrar una venta':'Tu caja, a un toque',erp?'Register a sale':'Your checkout, one tap away')}</h1><p class="muted">{l('Elige productos y prueba un cobro sin realizar ninguna transacción.','Pick products and try checkout without making a transaction.')}</p></div></div>
    <div class="checkout-layout"><div><div class="catalog-tools"><label class="search-field"><Icon name="search"/><span class="sr-only">{l('Buscar productos','Search products')}</span><input id="product-search" type="search" placeholder={l('Nombre o código de producto…','Product name or code…')}/></label><label class="sr-only" for="product-category">{l('Categoría','Category')}</label><select id="product-category"><option value="all">{l('Todas las categorías','All categories')}</option><option value="drinks">{l('Bebidas','Drinks')}</option><option value="food">{l('Comida','Food')}</option>{erp&&<><option value="tech">{l('Tecnología','Technology')}</option><option value="office">{l('Papelería','Stationery')}</option></>}</select></div><div id="product-grid" class="product-grid"></div><p id="product-empty" class="empty-state" hidden>{l('No encontramos productos. Prueba otra búsqueda.','No products found. Try another search.')}</p></div>
     <aside class="cart-panel surface"><div class="section-title"><h2><Icon name="cart"/> {l('Tu cesta','Your basket')}</h2><span id="cart-count" class="pill">0</span></div><label for="sale-customer">{l('Cliente','Customer')}</label><select id="sale-customer"><option value="walk-in">{l('Venta de mostrador','Walk-in customer')}</option>{customers.map(c=><option value={c.id}>{c.name}</option>)}</select><div id="cart-lines" class="cart-lines"></div><label class="discount-field" for="sale-discount">{l('Descuento (%)','Discount (%)')}<input id="sale-discount" type="number" min="0" max="50" step="1" value="0"/></label><div class="cart-totals"><p>{l('Subtotal','Subtotal')}<span id="cart-subtotal"></span></p><p>{l('Descuento','Discount')}<span id="cart-discount"></span></p><p class="grand-total">{l('Total','Total')}<strong id="cart-total"></strong></p></div><button id="start-checkout" class="primary full-width" type="button" disabled>{l('Simular cobro','Simulate checkout')} →</button><button id="clear-cart" class="text-button full-width" type="button">{l('Vaciar cesta','Clear basket')}</button><small class="muted">{l('No se procesan pagos ni se emiten facturas reales.','No payments are processed or real invoices issued.')}</small></aside>
    </div>
   </section>
   <section data-screen="inventory" hidden><div class="screen-heading"><div><p class="overline">{l('CATÁLOGO','CATALOG')}</p><h1>{l('Productos e inventario','Products & inventory')}</h1><p class="muted">{l('Consulta existencias y explora la ficha de cada producto de ejemplo.','Check stock and explore the details of each sample product.')}</p></div><a class="primary button-link" href="#sales">{l('Ir a caja','Go to checkout')} →</a></div><label class="search-field inventory-search"><Icon name="search"/><span class="sr-only">{l('Buscar inventario','Search inventory')}</span><input type="search" id="inventory-search" placeholder={l('Filtrar inventario…','Filter inventory…')}/></label><div class="surface table-scroll"><table><caption class="sr-only">{l('Inventario de demostración','Demo inventory')}</caption><thead><tr><th>{l('Producto','Product')}</th><th>SKU</th><th>{l('Precio','Price')}</th><th>{l('Existencias','Stock')}</th><th>{l('Detalle','Details')}</th></tr></thead><tbody id="inventory-rows"></tbody></table></div><p id="inventory-empty" class="empty-state" hidden>{l('No hay coincidencias.','No matching products.')}</p></section>
   <section data-screen="customers" hidden><div class="screen-heading"><div><p class="overline">{l('RELACIONES QUE CRECEN','GROWING RELATIONSHIPS')}</p><h1>{l('Tus clientes','Your customers')}</h1><p class="muted">{l('Perfiles ficticios para conocer la experiencia de atención.','Fictional profiles to explore the customer experience.')}</p></div></div><div class="customer-grid">{customers.map((c,i)=><article class="surface customer-card"><span class="customer-avatar">{String.fromCharCode(65+i)}</span><span class="pill">{l('Ejemplo','Sample')}</span><h2>{c.name}</h2><p class="muted">{l('Perfil de muestra · Sin datos de contacto','Sample profile · No contact information')}</p><div><span>{l('Pedidos','Orders')}<strong>{c.orders}</strong></span><span>{l('Compras de ejemplo','Sample purchases')}<strong>{new Intl.NumberFormat(es?'es-CO':'en-US',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(c.total)}</strong></span></div><button class="secondary" type="button" data-customer={c.id}>{l('Preparar una venta','Prepare a sale')} →</button></article>)}</div></section>
   <section data-screen="reports" hidden><div class="screen-heading"><div><p class="overline">{l('DECISIONES CON CONTEXTO','DECISIONS WITH CONTEXT')}</p><h1>{l('Así se ve tu negocio','Your business at a glance')}</h1><p class="muted">{l('Indicadores y movimientos de una operación ficticia.','Indicators and activity from a fictional business.')}</p></div><label>{l('Periodo de ejemplo','Sample period')}<select id="report-period"><option value="day">{l('Día de muestra','Sample day')}</option><option value="week">{l('Semana de muestra','Sample week')}</option></select></label></div><div class="metrics"><article class="metric metric-featured"><span>{l('Ingresos simulados','Simulated revenue')}</span><strong id="report-revenue"></strong><small>{l('Sin movimientos bancarios','No bank activity')}</small></article><article class="metric"><span>{l('Operaciones de ejemplo','Sample transactions')}</span><strong id="report-count"></strong><small>{l('Incluye tus pruebas en esta pestaña','Includes your tests in this tab')}</small></article><article class="metric"><span>{l('Venta promedio','Average sale')}</span><strong id="report-average"></strong><small>{l('Importes en COP','Amounts in COP')}</small></article></div><article class="surface"><div class="section-title"><h2>{l('Actividad de la semana de ejemplo','Sample weekly activity')}</h2><span class="pill">COP</span></div><div id="sales-chart" class="business-chart" role="img" aria-label={l('Ingresos ficticios por día, de lunes a domingo','Fictional daily revenue, Monday to Sunday')}>{[42,68,51,89,62,100,74].map((h,i)=><div><span style={`--bar-height:${h}%`}><b>{[126,204,153,267,186,300,222][i]}k</b></span><small>{(es?['Lun','Mar','Mié','Jue','Vie','Sáb','Dom']:['Mon','Tue','Wed','Thu','Fri','Sat','Sun'])[i]}</small></div>)}</div></article><article class="surface reports-history"><h2>{l('Movimientos de ejemplo','Sample activity')}</h2><div id="report-sales"></div></article></section>
   <section data-screen="settings" hidden><div class="screen-heading"><div><p class="overline">{l('HECHO PARA TU OPERACIÓN','BUILT AROUND YOUR BUSINESS')}</p><h1>{l('Tu espacio, tu estilo','Your space, your style')}</h1><p class="muted">{l('Explora las opciones de presentación de esta muestra.','Explore the presentation options in this showcase.')}</p></div></div><article class="surface settings-preview"><h2>{l('Identidad del negocio de ejemplo','Sample business identity')}</h2><p>{l('Nombre comercial','Business name')}: <strong>{l('Café Aurora · Demostración','Aurora Café · Demo')}</strong></p><p>{l('Moneda','Currency')}: <strong>COP</strong></p><p>{l('Tipo de recibo','Receipt type')}: <strong>{l('Vista previa de ejemplo','Sample preview')}</strong></p><h3>{l('Acento de la interfaz','Interface accent')}</h3><div class="theme-swatches">{[['#0066eb',l('Azul','Blue')],['#14695d',l('Verde','Green')],['#7045a0',l('Violeta','Violet')]].map(([color,label])=><button type="button" data-accent={color} style={`--swatch:${color}`} aria-label={label} aria-pressed={color==='#0066eb'}/>)}</div><p class="muted">{l('El cambio se aplica a esta demo. La configuración del producto completo se adapta a cada implementación.','Changes apply to this demo. The full product is configured for each implementation.')}</p></article></section>
  </main>
  <nav class="pos-bottom-nav" aria-label={l('Navegación de EasyDrink','EasyDrink navigation')}>{nav.filter(([key])=>key!=='customers').map(([key,icon,label])=><a data-nav={key} href={`#${key}`}><Icon name={icon}/><span>{label}</span></a>)}</nav>
 </div>
</div>
<dialog id="checkout-dialog" class="demo-dialog" data-demo-dialog aria-labelledby="checkout-title"><div class="dialog-heading"><h2 id="checkout-title">{l('Cobro de demostración','Demo checkout')}</h2><button data-close class="icon-button" aria-label={l('Cerrar','Close')} type="button">✕</button></div><p class="muted">{l('Elige una forma de pago ficticia. No se solicitarán datos bancarios.','Choose a fictional payment method. No bank details are requested.')}</p><form id="checkout-form"><fieldset class="payment-methods"><legend>{l('Forma de pago','Payment method')}</legend><label><input type="radio" name="payment" value="cash" checked/>{l('Efectivo','Cash')}</label><label><input type="radio" name="payment" value="card"/>{l('Tarjeta de ejemplo','Sample card')}</label></fieldset><p class="checkout-amount" id="checkout-amount"></p><button class="primary full-width" type="submit" disabled>{l('Completar venta simulada','Complete simulated sale')}</button></form></dialog>
<dialog id="receipt-dialog" class="demo-dialog receipt-dialog" data-demo-dialog aria-labelledby="receipt-title"><div class="dialog-heading"><h2 id="receipt-title">{l('¡Recorrido completado!','Walkthrough complete!')}</h2><button data-close class="icon-button" aria-label={l('Cerrar','Close')} type="button">✕</button></div><p class="success-note">✓ {l('Venta simulada. No se realizó ningún cobro.','Simulated sale. No payment was made.')}</p><div class="paper-receipt"><h3>{l('RECIBO DE EJEMPLO','SAMPLE RECEIPT')}</h3><p>{name} · {l('Sin validez fiscal','Not a tax document')}</p><div id="receipt-lines"></div><div class="receipt-final"><strong>{l('Total','Total')}</strong><strong id="receipt-total"></strong></div><p>{l('Gracias por explorar la experiencia.','Thank you for exploring the experience.')}</p></div><button type="button" data-close-receipt class="secondary full-width">{l('Seguir explorando','Keep exploring')}</button></dialog>
<dialog id="product-dialog" class="demo-dialog" data-demo-dialog aria-labelledby="product-title"><div class="dialog-heading"><h2 id="product-title"></h2><button data-close class="icon-button" aria-label={l('Cerrar','Close')} type="button">✕</button></div><div id="product-details"></div><button id="product-to-cart" class="primary full-width" type="button">{l('Añadir a la cesta','Add to basket')} +</button></dialog>
<script>import '../../scripts/business-demo';</script>

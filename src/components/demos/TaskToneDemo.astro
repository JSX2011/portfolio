---
import Icon from '../DemoIcon.astro';
import type {Locale} from '../../data/catalog';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es',l=(a:string,b:string)=>es?a:b,base=import.meta.env.BASE_URL;
---
<div class="tasktone-app"><header class="tt-header"><a href="#home" class="tt-brand"><span><Icon name="music" size={26}/></span>TaskTone<span class="tt-prototype">{l('Prototipo','Prototype')}</span></a><nav aria-label={l('Navegación de TaskTone','TaskTone navigation')}><a href="#home" data-nav="home">{l('Inicio','Home')}</a><a href="#workspace" data-nav="workspace">{l('Explorar espacio','Explore workspace')} ↗</a></nav></header>
 <main id="demo-main"><section data-screen="home"><div class="tt-hero"><p class="tt-eyebrow"><span class="demo-dot"></span>{l('UN ESPACIO PARA EL TALENTO EN AUDIO','A SPACE FOR AUDIO TALENT')}</p><h1>{l('Tu sonido merece','Your sound deserves')}<br/><span>{l('su mejor versión.','its best version.')}</span></h1><p>{l('Un punto de encuentro entre creadores y profesionales del audio. Descubre una propuesta de experiencia para llevar una idea desde el primer archivo hasta la entrega.','A meeting point for creators and audio professionals. Discover a proposed experience that takes an idea from the first file to delivery.')}</p><div class="tt-hero-actions"><button type="button" class="primary" data-enter-role="creator">{l('Explorar como cliente','Explore as a client')} <Icon name="arrow"/></button><button type="button" class="secondary" data-enter-role="professional">{l('Explorar como profesional','Explore as a professional')}</button></div><small>{l('Sin registro · Archivos de muestra · Recorrido conceptual','No registration · Sample files · Conceptual workflow')}</small><div class="tt-visual"><div class="tt-waveform" aria-hidden="true">{Array.from({length:47},(_,i)=><span style={`--wave-height:${[20,37,58,31,76,92,65,44,81,100,52,28][i%12]}%;--wave-delay:${i*.035}s`}/>)}</div><div class="tt-visual-label"><span><Icon name="headphones"/>{l('Una idea. Un mejor sonido.','One idea. A better sound.')}</span><span>STUDIO / 01</span></div></div></div><div class="tt-feature-grid">{[['upload',l('Comparte tu idea','Share your idea'),l('Explora un encargo con un audio de ejemplo y define el resultado que buscas.','Explore a brief with a sample audio and define the result you are looking for.')],['users',l('Encuentra tu equipo','Find your team'),l('Descubre cómo se presenta un profesional y cómo se organiza su trabajo.','Discover how a professional is presented and how their work is organized.')],['check',l('Acompaña el proceso','Follow the process'),l('Consulta el avance, revisa una entrega de muestra y explora la aprobación.','Track progress, review a sample delivery and explore approval.')]].map(([icon,title,copy])=><article><span class="soft-icon"><Icon name={icon} size={26}/></span><h2>{title}</h2><p class="muted">{copy}</p></article>)}</div><p class="tt-concept-note">{l('TaskTone está en etapa de prototipo. El espacio de encargos muestra una propuesta interactiva del recorrido previsto.','TaskTone is at the prototype stage. The order workspace presents an interactive proposal of the planned workflow.')}</p></section>
 <section data-screen="workspace" class="tt-workspace" hidden><div class="tt-workspace-top"><div><p class="overline">{l('TU ESTUDIO, CONECTADO','YOUR STUDIO, CONNECTED')}</p><h1 id="tt-workspace-title">{l('Hola, creador.','Hello, creator.')}</h1><p class="muted">{l('Explora tus proyectos de audio en este espacio de muestra.','Explore your audio projects in this sample workspace.')}</p></div><div class="tt-role-switch" role="group" aria-label={l('Rol de ejemplo','Sample role')}><button type="button" data-role="creator" aria-pressed="true">{l('Cliente','Client')}</button><button type="button" data-role="professional" aria-pressed="false">{l('Profesional','Professional')}</button></div></div><div class="tt-stats"><article><span>{l('Encargos de ejemplo','Sample orders')}</span><strong id="tt-stat-count">3</strong></article><article><span>{l('En proceso','In progress')}</span><strong id="tt-stat-active">1</strong></article><article><span>{l('Listos para revisar','Ready for review')}</span><strong id="tt-stat-review">1</strong></article></div><div class="section-title tt-orders-heading"><div><h2 id="tt-orders-title">{l('Tus encargos','Your orders')}</h2><p class="muted">{l('Contenido ficticio · No se reciben ni envían archivos','Fictional content · No files are received or sent')}</p></div><button id="new-order" type="button" class="primary"><Icon name="plus"/>{l('Probar nuevo encargo','Try a new order')}</button></div><div class="tt-filter-row"><label class="search-field"><Icon name="search"/><span class="sr-only">{l('Buscar encargos','Search orders')}</span><input id="tt-search" type="search" placeholder={l('Buscar proyecto…','Search projects…')}/></label><label><span class="sr-only">{l('Estado del encargo','Order status')}</span><select id="tt-filter"><option value="all">{l('Todos los estados','All statuses')}</option><option value="quote">{l('Por confirmar','Awaiting confirmation')}</option><option value="progress">{l('En proceso','In progress')}</option><option value="review">{l('En revisión','In review')}</option><option value="done">{l('Completado','Completed')}</option></select></label></div><div id="tt-orders" class="tt-orders"></div><div id="tt-empty" class="empty-state" hidden><h2>{l('No hay encargos con esos filtros.','No orders match these filters.')}</h2><p class="muted">{l('Prueba otro nombre o selecciona todos los estados.','Try another name or select all statuses.')}</p></div><article class="tt-professional surface"><span class="customer-avatar">ST</span><div><span class="pill">{l('Perfil de ejemplo','Sample profile')}</span><h2>{l('Estudio Tono','Tone Studio')}</h2><p class="muted">{l('Edición · Mezcla · Limpieza de audio','Editing · Mixing · Audio cleanup')}</p><p>{l('Un perfil ficticio para explorar cómo se presenta el talento dentro de la plataforma.','A fictional profile for exploring how talent is presented within the platform.')}</p></div><button id="view-professional" type="button" class="secondary">{l('Ver perfil','View profile')} →</button></article></section>
 <section data-screen="order" class="tt-workspace" hidden><a href="#workspace" class="text-button">← {l('Volver a los encargos','Back to orders')}</a><div class="screen-heading tt-order-heading"><div><p class="overline" id="tt-order-id"></p><h1 id="tt-order-title"></h1></div><span id="tt-order-status" class="pill"></span></div><ol id="tt-timeline" class="tt-timeline"></ol><div class="tt-order-columns"><article class="surface"><div class="section-title"><h2>{l('El encargo','The brief')}</h2><Icon name="headphones"/></div><p id="tt-order-description"></p><dl><div><dt>{l('Servicio','Service')}</dt><dd id="tt-order-service"></dd></div><div><dt>{l('Profesional de ejemplo','Sample professional')}</dt><dd>{l('Estudio Tono','Tone Studio')}</dd></div><div><dt>{l('Presupuesto ilustrativo','Illustrative budget')}</dt><dd id="tt-order-price"></dd></div></dl><div class="tt-audio"><span><Icon name="music"/>{l('Audio de muestra · Preparado para la demo','Sample audio · Prepared for the demo')}</span><audio id="sample-audio" controls preload="none" src={`${base}demos/tasktone-sample.wav`}></audio></div><p class="muted">{l('El audio es un recurso preparado. No se realiza procesamiento de sonido.','The audio is a prepared asset. No sound processing is performed.')}</p><div id="tt-order-actions" class="tt-order-actions"></div></article><article class="surface"><h2>{l('Conversación del proyecto','Project conversation')}</h2><p class="muted">{l('Mensajes de muestra que permanecen únicamente en esta pestaña.','Sample messages that remain only in this tab.')}</p><div id="tt-comments" class="tt-comments" aria-live="polite" aria-relevant="additions"></div><form id="tt-message-form"><label class="sr-only" for="tt-message">{l('Mensaje de ejemplo','Sample message')}</label><textarea id="tt-message" rows="3" maxlength="600" placeholder={l('Escribe un comentario de prueba…','Write a sample comment…')} required></textarea><button type="submit" class="secondary" disabled>{l('Añadir comentario de prueba','Add sample comment')} →</button></form></article></div></section>
 </main><footer class="tt-footer"><strong>TaskTone</strong><p>{l('Una propuesta para conectar creatividad y talento.','A proposal to connect creativity and talent.')}</p><span>{l('Prototipo · Experiencia de muestra','Prototype · Sample experience')}</span></footer>
</div>
<dialog id="tt-new-dialog" class="demo-dialog" data-demo-dialog aria-labelledby="tt-new-title"><div class="dialog-heading"><h2 id="tt-new-title">{l('Da forma a un encargo','Shape a brief')}</h2><button data-close class="icon-button" type="button" aria-label={l('Cerrar','Close')}>✕</button></div><p class="muted">{l('Selecciona un archivo preparado para explorar el proceso. No necesitas subir archivos personales.','Select a prepared file to explore the process. You do not need to upload personal files.')}</p><form id="tt-new-form"><label for="tt-new-name">{l('Nombre de ejemplo','Sample name')}</label><input id="tt-new-name" type="text" maxlength="80" required value={l('Mi proyecto de audio','My audio project')}/><label for="tt-new-file">{l('Archivo de muestra','Sample file')}</label><select id="tt-new-file"><option value="podcast">Podcast-demo.wav · 3 min</option><option value="voice">Voice-demo.wav · 1 min</option><option value="music">Music-demo.wav · 2 min</option></select><label for="tt-new-service">{l('Servicio','Service')}</label><select id="tt-new-service"><option value="cleanup">{l('Limpieza de audio','Audio cleanup')}</option><option value="mix">{l('Mezcla','Mixing')}</option><option value="edit">{l('Edición','Editing')}</option></select><label for="tt-new-notes">{l('Objetivo de ejemplo','Sample goal')}</label><textarea id="tt-new-notes" rows="3" maxlength="500" placeholder={l('Describe el resultado que buscas…','Describe the result you are looking for…')}></textarea><p class="tt-form-note">{l('La duración y el precio serán ilustrativos. No se cargará ni procesará un archivo.','Duration and pricing will be illustrative. No file will be uploaded or processed.')}</p><button type="submit" class="primary full-width" disabled>{l('Crear encargo de ejemplo','Create sample order')} →</button></form></dialog>
<dialog id="tt-profile-dialog" class="demo-dialog" data-demo-dialog aria-labelledby="tt-profile-title"><div class="dialog-heading"><h2 id="tt-profile-title">{l('Estudio Tono','Tone Studio')}</h2><button data-close class="icon-button" type="button" aria-label={l('Cerrar','Close')}>✕</button></div><span class="pill">{l('Profesional ficticio','Fictional professional')}</span><h3>{l('Cada detalle cuenta. Cada sonido también.','Every detail matters. Every sound does too.')}</h3><p>{l('Este perfil muestra cómo un profesional podría presentar sus servicios y especialidades en TaskTone.','This profile shows how a professional could present their services and specialties on TaskTone.')}</p><div class="tt-specialties"><span>{l('Edición de voz','Voice editing')}</span><span>Podcast</span><span>{l('Mezcla','Mixing')}</span></div><p class="muted">{l('No representa a una persona real ni permite contratar servicios.','It does not represent a real person or allow hiring services.')}</p><button type="button" id="tt-profile-create" class="primary">{l('Explorar un encargo','Explore an order')} →</button></dialog>
<script>import '../../scripts/tasktone-demo';</script>

---
import Icon from '../DemoIcon.astro';
import {sampleTitles} from '../../data/tv-demo';
import type {Locale} from '../../data/catalog';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es',l=(a:string,b:string)=>es?a:b;
const titles=sampleTitles(locale);
---
<div class="tv-app"><header class="tv-header"><a class="tv-brand" href="#catalog"><Icon name="tv" size={34}/><span>AKASHIC <b>TV</b></span></a><nav aria-label={l('Tipo de catálogo','Catalog type')}><button type="button" data-kind="movie" aria-pressed="true">{l('Películas','Movies')}</button><button type="button" data-kind="series" aria-pressed="false">{l('Series','Series')}</button></nav><span class="tv-alpha">ALPHA 0.2.5</span></header>
 <main id="demo-main" class="tv-main"><section data-screen="catalog"><div class="tv-catalog-heading"><div><p class="overline">{l('ENCUENTRA TU PRÓXIMA HISTORIA','FIND YOUR NEXT STORY')}</p><h1>{l('Una historia te espera.','A story is waiting for you.')}</h1></div><p class="muted">{l('Catálogo ficticio','Fictional catalog')}<br/>{l('Explora con el mouse o las flechas del teclado','Explore with the mouse or keyboard arrows')}</p></div><div class="tv-search-row"><label class="search-field"><Icon name="search"/><span class="sr-only">{l('Buscar títulos','Search titles')}</span><input id="tv-search" type="search" placeholder={l('¿Qué te gustaría descubrir?','What would you like to discover?')}/></label><label><span class="sr-only">{l('Género','Genre')}</span><select id="tv-genre"><option value="all">{l('Todos los géneros','All genres')}</option><option value="scifi">{l('Ciencia ficción','Science fiction')}</option><option value="drama">Drama</option><option value="adventure">{l('Aventura','Adventure')}</option></select></label><label><span class="sr-only">{l('Año','Year')}</span><select id="tv-year"><option value="all">{l('Todos los años','All years')}</option><option>2030</option><option>2029</option><option>2028</option></select></label></div><div class="tv-results-heading"><h2 id="catalog-name">{l('Películas para explorar','Movies to explore')}</h2><span id="tv-count" class="muted" role="status" aria-live="polite"></span></div><div class="tv-posters" id="tv-grid">{titles.map((t,i)=><button class="poster-card" data-title={t.id} data-kind={t.kind} data-genre={t.genre} data-year={t.year} type="button" hidden={t.kind!=='movie'} aria-label={l('Ver ficha: ','View details: ')+t.title}><span class:list={['poster-art',`scene-${t.scene}`]} style={`--poster-color:${t.color}`}><span class="poster-orb"></span><span class="poster-land"></span><span class="poster-number">{String(i+1).padStart(2,'0')}</span><span class="poster-lettering">{t.title}</span><span class="poster-mark">AKASHIC ORIGINAL DEMO</span><span class="poster-explore"><Icon name="play"/>{l('Explorar','Explore')}</span></span><strong>{t.title}</strong><small>{t.year} <span>·</span> {t.kind==='movie'?l('Película','Movie'):l('Serie','Series')}</small></button>)}</div><div id="tv-empty" class="empty-state" hidden><Icon name="search" size={36}/><h2>{l('Una búsqueda diferente, otra historia.','A different search, another story.')}</h2><p class="muted">{l('No hay coincidencias en este catálogo de ejemplo.','There are no matches in this sample catalog.')}</p><button id="tv-clear" type="button" class="secondary">{l('Restablecer filtros','Reset filters')}</button></div><p class="tv-footnote">{l('Todos los títulos e ilustraciones son ficticios. La aplicación para Samsung Tizen continúa en alfa.','All titles and artwork are fictional. The Samsung Tizen application remains in alpha.')}</p></section>
 <section data-screen="player" hidden><button id="player-back" class="secondary" type="button">← {l('Volver al catálogo','Back to catalog')}</button><div class="tv-player-stage"><div class="tv-player-scenery"><span class="player-planet"></span><span class="player-horizon"></span></div><div class="tv-player-caption"><span class="pill">{l('VISTA SIMULADA','SIMULATED VIEW')}</span><h1 id="player-title"></h1><p>{l('Explora los controles. Esta muestra no reproduce películas ni conecta con proveedores.','Explore the controls. This showcase does not play films or connect to providers.')}</p></div><div class="tv-player-controls"><button id="player-toggle" class="primary" type="button">▶ {l('Iniciar vista','Start preview')}</button><label for="player-progress" class="sr-only">{l('Posición de la vista simulada','Simulated preview position')}</label><input id="player-progress" type="range" min="0" max="120" value="0"/><span id="player-time">0:00 / 2:00</span></div></div><div class="tv-options surface"><h2>{l('Tu experiencia, a tu manera','Your experience, your way')}</h2><p class="muted">{l('Estos ajustes solo cambian los controles de la demostración.','These settings only change the demonstration controls.')}</p><div><label>{l('Audio','Audio')}<select id="player-audio"><option value="es">Español · Demo</option><option value="en">English · Demo</option></select></label><label>{l('Subtítulos','Subtitles')}<select id="player-subtitles"><option value="off">{l('Desactivados','Off')}</option><option value="es">Español</option><option value="en">English</option></select></label><label>{l('Proveedor de ejemplo','Sample provider')}<select id="player-provider"><option value="a">{l('Proveedor A · Simulado','Provider A · Simulated')}</option><option value="b">{l('Proveedor B · Simulado','Provider B · Simulated')}</option></select></label></div><p id="player-subtitle-preview" class="subtitle-preview" hidden></p></div></section></main>
</div>
<dialog id="tv-details" class="demo-dialog tv-detail-dialog" data-demo-dialog aria-labelledby="tv-detail-title"><div class="dialog-heading"><p class="overline">{l('TU PRÓXIMA HISTORIA','YOUR NEXT STORY')}</p><button data-close class="icon-button" type="button" aria-label={l('Cerrar ficha','Close details')}>✕</button></div><div class="tv-detail-layout"><div id="detail-art" class="poster-art"><span class="poster-orb"></span><span class="poster-land"></span><span id="detail-poster-title" class="poster-lettering"></span></div><div><h2 id="tv-detail-title"></h2><p id="tv-detail-meta" class="tv-detail-meta"></p><p id="tv-detail-description"></p><p class="muted">{l('Reparto y dirección: equipo ficticio de demostración.','Cast and direction: fictional demo team.')}</p><button id="play-title" class="primary" type="button"><Icon name="play"/>{l('Explorar reproductor','Explore player')}</button><p class="muted">{l('Controles simulados, sin reproducción externa.','Simulated controls, no external playback.')}</p></div></div><div id="tv-episodes" hidden><div class="section-title"><h3>{l('Episodios de ejemplo','Sample episodes')}</h3><label><span class="sr-only">{l('Temporada','Season')}</span><select id="tv-season"><option value="1">{l('Temporada 1','Season 1')}</option><option value="2">{l('Temporada 2','Season 2')}</option></select></label></div><div id="episode-list"></div></div></dialog>
<script>import '../../scripts/tv-demo';</script>

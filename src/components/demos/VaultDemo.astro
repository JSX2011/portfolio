---
import Icon from '../DemoIcon.astro';
import type {Locale} from '../../data/catalog';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es',l=(a:string,b:string)=>es?a:b;
const nav=[['chat','chat',l('Conversación','Conversation')],['models','grid',l('Modelos','Models')],['vault','lock',l('Bóveda e historial','Vault & history')],['studio','image',l('Estudio creativo','Creative studio')],['settings','settings',l('Ajustes','Settings')]];
---
<div class="vault-app">
 <aside class="vault-sidebar"><a class="vault-brand" href="#chat"><span class="vault-mark">✧</span>Akashic Vault</a><button id="new-chat" class="vault-new secondary" type="button"><Icon name="plus"/>{l('Nueva conversación','New conversation')}</button><p class="nav-caption">{l('TU ESPACIO LOCAL','YOUR LOCAL WORKSPACE')}</p><nav aria-label={l('Herramientas de Akashic Vault','Akashic Vault tools')}>{nav.map(([key,icon,label])=><a data-nav={key} href={`#${key}`}><Icon name={icon}/>{label}</a>)}</nav><div class="vault-history"><p class="nav-caption">{l('CONVERSACIONES DE EJEMPLO','SAMPLE CONVERSATIONS')}</p><button type="button" data-history="ideas">{l('Ideas para un nuevo proyecto','Ideas for a new project')}</button><button type="button" data-history="code">{l('Una función, paso a paso','A function, step by step')}</button></div><div class="vault-sidebar-footer"><span class="demo-dot"></span>{l('Espacio de demostración','Demo workspace')}<small>v0.6.0-dev · {l('En desarrollo','In development')}</small></div></aside>
 <div class="vault-shell"><header class="vault-topbar"><div><strong>{l('Tu espacio para pensar','Your space to think')}</strong><small id="vault-engine">{l('Modelo de ejemplo · Asistente','Sample model · Assistant')}</small></div><button id="vault-theme" class="icon-button" type="button" aria-label={l('Cambiar tema','Switch theme')}><Icon name="moon"/></button></header>
  <main id="demo-main">
   <section data-screen="chat" class="vault-chat"><div class="vault-chat-header"><div class="mode-switch" role="group" aria-label={l('Modo de asistencia','Assistance mode')}>{[['general','spark',l('Asistente','Assistant')],['code','code',l('Programación','Coding')],['writing','pen',l('Escritura','Writing')]].map(([key,icon,label])=><button type="button" data-mode={key} aria-pressed={key==='general'}><Icon name={icon}/><span>{label}</span></button>)}</div><button id="save-chat" class="text-button" type="button"><Icon name="folder"/>{l('Guardar ejemplo','Save example')}</button></div>
    <div id="chat-messages" class="chat-messages" aria-live="polite" aria-relevant="additions"><div id="vault-welcome" class="vault-welcome"><span class="welcome-star">✧</span><p class="overline">AKASHIC VAULT</p><h1>{l('Una idea puede ser','An idea can be')}<br/><em>{l('el comienzo de todo.','the beginning of everything.')}</em></h1><p class="muted">{l('Un espacio tranquilo para escribir, programar y dar forma a tus ideas. Explora una conversación de muestra.','A calm space to write, code and shape your ideas. Explore a sample conversation.')}</p><div class="prompt-suggestions"><button type="button" data-prompt="ideas"><Icon name="spark"/>{l('Organizar un proyecto','Plan a project')}<span>↗</span></button><button type="button" data-prompt="code"><Icon name="code"/>{l('Explorar una función','Explore a function')}<span>↗</span></button><button type="button" data-prompt="writing"><Icon name="pen"/>{l('Dar forma a un texto','Shape a piece of writing')}<span>↗</span></button></div></div></div>
    <form id="chat-form" class="vault-composer"><label for="chat-input" class="sr-only">{l('Mensaje de prueba','Sample message')}</label><textarea id="chat-input" rows="2" maxlength="1200" placeholder={l('Escribe una idea para probar la interfaz…','Write an idea to try the interface…')} required></textarea><div><span class="muted">{l('Respuestas de ejemplo · Sin procesamiento de IA','Sample responses · No AI processing')}</span><button type="submit" class="primary" disabled aria-label={l('Enviar mensaje de prueba','Send sample message')}><Icon name="arrow"/></button></div></form>
   </section>
   <section data-screen="models" class="vault-content" hidden><p class="overline">{l('ELIGE TU COMPAÑERO','CHOOSE YOUR COMPANION')}</p><h1>{l('Un modelo para cada idea.','A model for every idea.')}</h1><p class="muted">{l('Compara perfiles de ejemplo y prueba cómo cambia el espacio de conversación. No se instala ni descarga ningún motor.','Compare sample profiles and see how the conversation workspace changes. No engine is installed or downloaded.')}</p><div class="vault-model-grid">{[['balanced','spark',l('Equilibrado','Balanced'),l('Ideas, preguntas y tareas de cada día.','Ideas, questions and everyday tasks.'),'8 GB'],['coder','code',l('Programación','Coding'),l('Un espacio dedicado a explorar y explicar código.','A space dedicated to exploring and explaining code.'),'16 GB'],['creative','pen',l('Creativo','Creative'),l('Borradores, estructura y nuevas perspectivas.','Drafts, structure and fresh perspectives.'),'16 GB']].map(([key,icon,title,copy,ram])=><article class="surface model-card"><span class="soft-icon"><Icon name={icon} size={30}/></span><span class="pill">{l('Perfil de ejemplo','Sample profile')}</span><h2>{title}</h2><p class="muted">{copy}</p><dl><div><dt>{l('Memoria ilustrativa','Illustrative memory')}</dt><dd>{ram}</dd></div><div><dt>{l('Disponibilidad en demo','Demo availability')}</dt><dd>{l('Simulada','Simulated')}</dd></div></dl><button class="secondary" type="button" data-model={key} aria-pressed={key==='balanced'}>{key==='balanced'?l('Seleccionado','Selected'):l('Seleccionar perfil','Select profile')}</button></article>)}</div></section>
   <section data-screen="vault" class="vault-content" hidden><p class="overline">{l('UN LUGAR PARA VOLVER','A PLACE TO RETURN TO')}</p><div class="screen-heading"><div><h1>{l('Bóveda e historial.','Vault & history.')}</h1><p class="muted">{l('Explora el recorrido de guardar, consultar y bloquear. Esta muestra no cifra ni almacena archivos.','Explore saving, reviewing and locking. This showcase does not encrypt or store files.')}</p></div><button id="toggle-vault" class="secondary" type="button"><Icon name="lock"/>{l('Bloquear muestra','Lock showcase')}</button></div><div id="vault-locked" class="surface locked-state" hidden><Icon name="lock" size={42}/><h2>{l('Vista de bóveda bloqueada','Vault view locked')}</h2><p class="muted">{l('El bloqueo es una simulación visual. Usa el botón superior para continuar.','Locking is a visual simulation. Use the button above to continue.')}</p></div><div id="vault-records" class="vault-records"></div></section>
   <section data-screen="studio" class="vault-content" hidden><p class="overline">{l('DE LA IDEA A LA IMAGEN','FROM IDEA TO IMAGE')}</p><h1>{l('Un estudio para imaginar.','A studio for imagination.')}</h1><p class="muted">{l('Prueba los controles creativos y descubre una salida preparada para esta demostración.','Try the creative controls and discover an output prepared for this showcase.')}</p><div class="studio-grid"><form id="studio-form" class="surface"><label for="studio-type">{l('Tipo de creación','Creation type')}</label><select id="studio-type"><option value="image">{l('Imagen','Image')}</option><option value="video">{l('Video · Vista simulada','Video · Simulated preview')}</option></select><label for="studio-prompt">{l('Tu idea de ejemplo','Your sample idea')}</label><textarea id="studio-prompt" rows="4" maxlength="500" placeholder={l('Un paisaje sereno bajo un cielo violeta…','A peaceful landscape beneath a violet sky…')} required></textarea><label for="studio-style">{l('Estilo','Style')}</label><select id="studio-style"><option value="dream">{l('Onírico','Dreamlike')}</option><option value="clear">{l('Luz natural','Natural light')}</option><option value="mono">{l('Monocromo','Monochrome')}</option></select><button type="submit" class="primary full-width" disabled>{l('Mostrar resultado de ejemplo','Show sample result')} →</button><p class="muted">{l('Vista previa predefinida; no genera imágenes ni video.','Predefined preview; no images or videos are generated.')}</p></form><div class="surface studio-output"><div id="studio-placeholder"><Icon name="image" size={48}/><h2>{l('Aquí empieza lo visual.','This is where the visual begins.')}</h2><p class="muted">{l('Describe una idea y explora la vista previa.','Describe an idea and explore the preview.')}</p></div><figure id="studio-result" hidden><div class="generated-landscape" role="img" aria-label={l('Ilustración de muestra: montañas, sol y cielo violeta','Sample illustration: mountains, sun and violet sky')}><span class="landscape-sun"></span><span class="landscape-ridge back"></span><span class="landscape-ridge front"></span><span class="landscape-water"></span></div><figcaption id="studio-caption"></figcaption><p class="muted">{l('Recurso visual de ejemplo · Sin IA activa','Sample visual asset · No active AI')}</p></figure></div></div></section>
   <section data-screen="settings" class="vault-content" hidden><p class="overline">{l('HAZLO TUYO','MAKE IT YOURS')}</p><h1>{l('Un espacio a tu medida.','A space that feels like you.')}</h1><article class="surface vault-settings"><h2>{l('Apariencia','Appearance')}</h2><label for="vault-appearance">{l('Tema de la interfaz','Interface theme')}</label><select id="vault-appearance"><option value="dark">{l('Oscuro','Dark')}</option><option value="light">{l('Claro','Light')}</option></select><h2>{l('Acerca de esta experiencia','About this experience')}</h2><p class="muted">{l('Esta interfaz permite explorar los recorridos de Akashic Vault con respuestas predefinidas. El producto para Windows continúa en desarrollo.','This interface lets you explore Akashic Vault workflows with predefined responses. The Windows product remains in development.')}</p><dl><div><dt>{l('Conversaciones de prueba','Test conversations')}</dt><dd>{l('Solo en esta pestaña','Only in this tab')}</dd></div><div><dt>{l('Modelos y motores','Models and engines')}</dt><dd>{l('No se ejecutan en esta demo','Not executed in this demo')}</dd></div></dl></article></section>
  </main>
 </div>
</div>
<script>import '../../scripts/vault-demo';</script>

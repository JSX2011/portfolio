---
import Accessibility from './Accessibility.astro';
import VaultDemo from './demos/VaultDemo.astro';
import BusinessDemo from './demos/BusinessDemo.astro';
import TvDemo from './demos/TvDemo.astro';
import TaskToneDemo from './demos/TaskToneDemo.astro';
import {getProjects} from '../i18n';
import {demoKinds,type Locale,type SoftwareDemoId} from '../data/catalog';
import '../styles/software-demos.css';
const {locale,id}=Astro.props as {locale:Locale;id:SoftwareDemoId};
const base=import.meta.env.BASE_URL,es=locale==='es',p=getProjects(locale).find(p=>p.id===id)!;
const path=(lang:Locale)=>`${base}${lang}/demos/${id}/`;
const note=id==='tasktone'?(es?'Propuesta interactiva · Datos ficticios':'Interactive concept · Sample data'):(es?'Demo interactiva · Datos ficticios':'Interactive demo · Sample data');
---
<!doctype html>
<html lang={locale}>
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{p.name} — {es?'Demo interactiva':'Interactive demo'} · SD Tech Systems</title>
 <meta name="description" content={p.description}/><meta name="robots" content="noindex, follow"/>
 <meta http-equiv="Content-Security-Policy" content={import.meta.env.PROD?"default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'none'; form-action 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'":"form-action 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'"}/>
 <meta name="theme-color" content="#061C45"/><link rel="icon" href={`${base}favicon.ico`}/>
 <link rel="canonical" href={new URL(path(locale),Astro.site)}/>
 {(['es','en'] as const).map(lang=><link rel="alternate" hreflang={lang} href={new URL(path(lang),Astro.site)}/>)}
 <script is:inline>try{const s=JSON.parse(localStorage.getItem('sd-tech-accessibility-v1')||'{}');if(['1','1.15','1.3','1.5'].includes(s.size))document.documentElement.style.setProperty('--text-scale',s.size);['contrast','spacing','links','motion'].forEach(k=>document.documentElement.toggleAttribute('data-'+k,s[k]===true));}catch{}</script>
</head>
<body class:list={['software-demo',`demo-${id}`]} data-demo={id} data-kind={demoKinds[id]}>
 <a class="demo-skip" href="#demo-main">{es?'Saltar al contenido':'Skip to content'}</a>
 <header class="demo-toolbar">
  <a class="demo-back" href={`${base}${locale}/proyectos/${id}/`}>← <span>{es?'Volver al proyecto':'Back to project'}</span></a>
  <p><span class="demo-dot" aria-hidden="true"></span>{note}</p>
  <div class="demo-toolbar-actions"><button id="reset-demo" type="button">↻ {es?'Reiniciar demo':'Reset demo'}</button><nav aria-label={es?'Idioma':'Language'}>{(['es','en'] as const).map(lang=><a lang={lang} hreflang={lang} href={path(lang)} aria-current={locale===lang?'page':undefined}>{lang.toUpperCase()}</a>)}</nav></div>
 </header>
 <noscript><p class="nojs-notice">{es?'Activa JavaScript para explorar las interacciones. Esta muestra no envía información.':'Enable JavaScript to explore the interactions. This showcase does not send information.'}</p></noscript>
 {id==='akashic-vault'&&<VaultDemo locale={locale}/>}
 {(id==='openmultipos'||id==='easy-drink')&&<BusinessDemo locale={locale} id={id}/>}
 {id==='akashic-tv'&&<TvDemo locale={locale}/>}
 {id==='tasktone'&&<TaskToneDemo locale={locale}/>}
 <footer class="demo-footer"><a href={`${base}${locale}/`}>SD Tech Systems</a><a href={`${base}${locale}/#contacto`}>{es?'Conversemos sobre tu proyecto':'Let’s talk about your project'} ↗</a><a href={`${base}demos/ATTRIBUTIONS.txt`}>{es?'Créditos':'Credits'}</a></footer>
 <div id="demo-notice" class="demo-toast" role="status" aria-live="polite" aria-atomic="true"></div>
 <Accessibility locale={locale}/>
 <script>
   document.querySelector('#reset-demo')?.addEventListener('click',()=>location.reload());
 </script>
</body>
</html>

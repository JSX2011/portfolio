---
import SiteLayout from './SiteLayout.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import Brand from './Brand.astro';
import { getProjects, words } from '../i18n';
import { siteConfig, type Locale } from '../data/catalog';
const { locale,id }=Astro.props as {locale:Locale;id:string};
const projects=getProjects(locale), p=projects.find(p=>p.id===id)!;
const next=projects[(projects.indexOf(p)+1)%projects.length],t=words[locale],base=import.meta.env.BASE_URL;
const inquiry=`mailto:${siteConfig.email}?subject=${encodeURIComponent(`${t.inquiry}: ${p.name}`)}`;
---
<SiteLayout locale={locale} title={`${p.name} — SD Tech Systems`} description={p.description} projectId={p.id}>
  <nav class="wrap detail-nav" aria-label={t.projects}><a href={`${base}${locale}/#proyectos`}>← {t.back}</a><Brand href={`${base}${locale}/`}/><LanguageSwitch locale={locale} projectId={p.id}/></nav>
  <main id="contenido">
    <section class="wrap detail-hero"><p class="eyebrow">{p.category.toUpperCase()}</p><h1>{p.name}<span class="accent">.</span></h1><div class="detail-intro"><p>{p.description}</p><span class="status"><i></i>{p.status} · {p.version}</span></div><a class="project-inquiry" href={inquiry}>{t.inquiry} ↗</a></section>
    <figure class="detail-image" style="margin:0"><button id="enlarge" aria-label={`${t.zoom} ${p.name}`}><img src={`${base}screenshots/${p.image}`} alt={`${locale==='es'?'Interfaz de':'Interface of'} ${p.name}`} width="1440" height="900"/></button><figcaption class="caption">↗ {t.zoomHint} {p.capture}</figcaption></figure>
    <section class="wrap client-section"><p class="eyebrow">{t.what}</p><div class="client-facts"><div><h2>{t.audience}</h2><p>{p.details.audience}</p></div><div><h2>{t.purpose}</h2><p>{p.details.purpose}</p></div></div></section>
    <section class="wrap detail-body"><div><p class="eyebrow">{t.construction}</p><h2>{t.architecture}</h2><p class="client-copy">{p.details.architecture}</p><div class="stack-list" aria-label={t.tech}>{p.stack.map(s=><span>{s}</span>)}</div><h2>{t.deployment}</h2><p class="client-copy">{p.details.deployment}</p><h2>{t.features}</h2><ul class="feature-list">{p.features.map(f=><li>{f}</li>)}</ul>{p.details.attribution&&<p class="attribution">{p.details.attribution}</p>}{!p.private&&<a class="source-link" href={`https://github.com/JSX2011/${p.source}`} target="_blank" rel="noopener noreferrer">{t.source} ↗</a>}</div><aside class="development"><p class="eyebrow">{t.status}</p><h2>{p.status}</h2><p>{p.progress}</p><h2>{t.considerations}</h2><p>{p.details.considerations}</p><p>{t.terms}</p><a class="project-inquiry" href={inquiry}>{t.contact} ↗</a><p class="evidence-note">{t.review} {p.private?t.privateCode:''}</p></aside></section>
    <nav class="wrap detail-next" aria-label={t.projects}><a href={`${base}${locale}/#proyectos`}>← {t.back}</a><div><p>{t.next}</p><a class="source-link" style="margin:0" href={`${base}${locale}/proyectos/${next.id}/`}>{next.name} ↗</a></div></nav>
  </main>
  <dialog id="capture-dialog" aria-label={`${t.zoom} ${p.name}`}><button id="close-dialog" type="button">{t.close} ✕</button><img src={`${base}screenshots/${p.image}`} alt={`${t.zoom} ${p.name}`}/><p>{p.capture}</p></dialog>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('#capture-dialog');
 document.querySelector('#enlarge')?.addEventListener('click',()=>dialog?.showModal());
 document.querySelector('#close-dialog')?.addEventListener('click',()=>dialog?.close());
 dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
</script>
</SiteLayout>

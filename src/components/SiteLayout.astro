---
import Accessibility from './Accessibility.astro';
import Motion from './Motion.astro';
import Brand from './Brand.astro';
import { siteConfig, type Locale } from '../data/catalog';
import { words } from '../i18n';
import '../styles.css';
const { locale, title, description, projectId }=Astro.props as {locale:Locale;title:string;description:string;projectId?:string};
const t=words[locale], base=import.meta.env.BASE_URL;
const suffix=projectId?`proyectos/${projectId}/`:'';
const url=(lang:string)=>new URL(`${base}${lang}/${suffix}`,Astro.site).href;
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#07111F"/>
  <meta http-equiv="Content-Security-Policy" content={import.meta.env.PROD?"form-action 'none'; frame-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'self'":"form-action 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'"}/>
  <link rel="canonical" href={url(locale)}/><link rel="alternate" hreflang="es" href={url('es')}/><link rel="alternate" hreflang="en" href={url('en')}/><link rel="alternate" hreflang="x-default" href={url('es')}/>
  <link rel="icon" href={`${base}favicon.ico`} sizes="any"/><link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32"/>
  <script is:inline>
    try {
      const saved=JSON.parse(localStorage.getItem('sd-tech-accessibility-v1')||'{}');
      if(saved&&typeof saved==='object'){
        if(['1','1.15','1.3','1.5'].includes(saved.size))document.documentElement.style.setProperty('--text-scale',saved.size);
        ['contrast','spacing','links','motion'].forEach(key=>document.documentElement.toggleAttribute(`data-${key}`,saved[key]===true));
      }
    } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#contenido">{t.skip}</a>
  <slot />
  <footer class="wrap"><Brand href={`${base}${locale}/`}/><div class="footer-signature"><span>{t.signature}</span><span>© {new Date().getFullYear()} {siteConfig.author}</span></div><span>{t.built}</span><a href="#">{t.top} ↑</a></footer>
  <Accessibility locale={locale}/><Motion />
</body>
</html>

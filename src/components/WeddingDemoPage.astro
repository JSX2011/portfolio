---
import { Image,getImage } from 'astro:assets';
import Icon from './WeddingIcon.astro';
import Rose from './WeddingRose.astro';
import { demoEvent,weddingCopy } from '../data/wedding-demo';
import type { Locale } from '../data/catalog';
import stationery from '../assets/wedding/stationery.png';
import table from '../assets/wedding/table.png';
import garden from '../assets/wedding/garden.png';
import '../styles/wedding-demo.css';
const {locale}=Astro.props as {locale:Locale};
const t=weddingCopy[locale],base=import.meta.env.BASE_URL;
const images=[stationery,table,garden];
const fullImages=await Promise.all(images.map(src=>getImage({src,width:1440,format:'webp'})));
const storyImages=[garden,table,stationery,garden];
const altLocale=locale==='es'?'en':'es';
const stamp=(value:string)=>value.replace(/[-:]/g,'').replace('.000','');
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{t.title} — SD Tech Systems</title><meta name="description" content={t.demo}/><meta name="theme-color" content="#faf8f2"/><meta name="robots" content="noindex,follow"/>
  <meta http-equiv="Content-Security-Policy" content={import.meta.env.PROD?"form-action 'none'; frame-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'self'":"form-action 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'"}/>
  <link rel="icon" href={`${base}favicon.ico`} sizes="any"/>
  <script is:inline>
    document.documentElement.classList.add('js');
    try{const p=JSON.parse(localStorage.getItem('sd-wedding-demo-access')||'{}');if(p&&typeof p==='object'){document.documentElement.dataset.textSize=['0','1','2'].includes(p.size)?p.size:'0';if(p.contrast===true)document.documentElement.dataset.contrast='high';if(p.motion===true)document.documentElement.dataset.motion='reduce';}}catch{}
  </script>
</head>
<body id="top" data-locale={locale} data-success={t.successText} data-person={t.person} data-updated={t.updated} data-restored={t.restored} data-of={t.of} data-count-ended={t.countEnded}>
  <a class="skip" href="#main">{t.skip}</a>
  <div class="demo-toolbar"><a href={`${base}${locale}/proyectos/invitacion/`}>← {t.back}</a><span>{t.demo}</span><a href={`${base}${altLocale}/demos/invitacion/`} lang={altLocale} hreflang={altLocale}>{t.language}</a></div>
  <div class="announcement">{t.announcement}</div>
  <header class="site-header container"><a class="wordmark" href="#top" aria-label="Alex & Sam">A<span>&</span>S<span class="wordmark-dot">.</span></a><nav aria-label={locale==='es'?'Navegación de la invitación':'Invitation navigation'}>{['story','day','memories','rsvp'].map((id,i)=><a href={`#${id}`}>{t.nav[i]}</a>)}</nav><div class="header-tools"><button class="access-button" type="button" data-access aria-label={t.access}><Icon name="access"/></button></div></header>
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow hero-date">{t.date}</p><p class="script">{t.married}</p><h1 class="couple-signature" id="hero-title" aria-label="Alex & Sam"><span class="signature-name">Alex</span><span class="signature-amp">&</span><span class="signature-name">Sam</span></h1><div class="short-rule" aria-hidden="true"></div><p class="hero-intro">{t.intro}</p><p class="hero-invitation">{t.invitation}</p></div><figure class="hero-portrait"><div class="portrait-outline" aria-hidden="true"></div><div class="portrait-image"><Image src={stationery} widths={[480,960,1440]} sizes="(max-width:700px) 90vw,46vw" format="webp" alt={t.galleryAlts[0]} loading="eager" fetchpriority="high"/></div><span class="portrait-seal" aria-hidden="true">A<span>&</span>S<small>15 · 06 · 30</small></span><figcaption>{t.heroCaption}</figcaption></figure></section>
    <section class="countdown-section" aria-labelledby="countdown-title"><div class="container countdown-layout"><div><p class="eyebrow">{t.countEyebrow}</p><h2 id="countdown-title">{t.countTitle}</h2><time datetime={demoEvent.date}>{t.fullDate}</time></div><div class="countdown" data-countdown data-target={demoEvent.start} aria-label={t.countTitle}>{t.units.map((label,i)=><div><span data-unit={['days','hours','minutes','seconds'][i]}>—</span><small>{label}</small></div>)}</div></div></section>
    <section class="story-journey container section-space" id="story" aria-labelledby="story-title"><div class="section-heading"><p class="eyebrow">{t.storyEyebrow}</p><h2 id="story-title">{t.storyTitle}</h2><p>{t.storyIntro}</p></div><div class="story-route"><svg class="rose-vine" fill="none" aria-hidden="true"><path class="vine-base"/><path class="vine-progress" pathLength="1"/></svg><ol class="story-path">{t.steps.map((step,i)=><li class="story-stop"><Rose/><span class="story-marker" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div class="story-stop-copy"><p class="eyebrow">{step.label}</p><h3>{step.title}</h3><p>{step.text}</p></div><figure class="story-stop-photo"><Image src={storyImages[i]} widths={[480,960]} sizes="(max-width:700px) 85vw,40vw" format="webp" alt={t.galleryAlts[[2,1,0,2][i]]} loading="lazy"/></figure></li>)}</ol><span class="travelling-rose" aria-hidden="true"><Rose travelling/></span></div><div class="story-destination"><Icon name="heart"/><p class="eyebrow">{t.destination}</p><h3>{t.destinationTitle}</h3><p>{t.destinationText}</p></div></section>
    <section class="day-section section-space" id="day" aria-labelledby="day-title"><div class="container"><div class="section-heading"><p class="eyebrow">{t.dayEyebrow}</p><h2 id="day-title">{t.dayTitle}</h2><p>{t.dayIntro}</p></div><div class="venues">{demoEvent.venues.map((venue,i)=><article class="venue"><div class="venue-top"><span class="venue-number">0{i+1}</span><Icon name={i===0?'heart':'calendar'}/><span class="eyebrow">{t.venueLabels[i]}</span></div><div class="venue-heading"><h3>{t.venueNames[i]}</h3><time datetime={venue.start}>{venue.time}<span>h</span></time></div><p class="venue-note">{t.venueNotes[i]}</p><address>{t.address}</address><button class="button button-outline" type="button" data-map={t.venueNames[i]}><Icon name="pin"/>{t.map}<Icon name="arrow"/></button><div class="map-frame demo-map-preview" aria-hidden="true"><span class="map-road map-road-one"></span><span class="map-road map-road-two"></span><span class="map-park"></span><span class="map-marker">⌖</span></div><details class="calendar-options"><summary><Icon name="calendar"/>{t.calendar}<span aria-hidden="true">+</span></summary><div class="calendar-content"><p>{t.calendarHint}</p><button class="calendar-download" type="button" data-calendar data-start={stamp(venue.start)} data-end={stamp(venue.end)} data-title={`Alex & Sam · ${t.venueLabels[i]}`} data-location={`${t.venueNames[i]} · ${t.address}`} data-event={venue.id}>{t.calendarDownload} ↓</button></div></details></article>)}</div></div></section>
    <section class="memories-section container section-space" id="memories" aria-labelledby="memories-title"><div class="section-heading"><p class="eyebrow">{t.memoriesEyebrow}</p><h2 id="memories-title">{t.memoriesTitle}</h2><p>{t.memoriesIntro}</p></div><div class="gallery">{images.map((image,i)=><figure class="memory"><button class="photo-button" type="button" data-photo={i} data-full={fullImages[i].src} aria-label={`${t.lightbox}: ${t.galleryNames[i]}`}><Image src={image} widths={[480,960]} sizes="(max-width:700px) 85vw,30vw" format="webp" alt={t.galleryAlts[i]} loading="lazy"/><span class="enlarge" aria-hidden="true"><Icon name="plus"/></span></button><figcaption><span class="memory-index">0{i+1}</span>{t.galleryNames[i]}</figcaption></figure>)}</div></section>
    <section class="guest-details section-space" id="details" aria-labelledby="details-title"><div class="container"><div class="section-heading"><p class="eyebrow">{t.detailsEyebrow}</p><h2 id="details-title">{t.detailsTitle}</h2></div><div class="guest-details-grid"><article class="dress-details"><Icon name="heart"/><h3>{t.dressTitle}</h3><p>{t.dressText}</p></article><article class="gift-details"><Icon name="gift"/><h3>{t.giftTitle}</h3><p>{t.giftText}</p></article></div></div></section>
    <section class="rsvp-section section-space" id="rsvp" aria-labelledby="rsvp-title"><div class="container rsvp-layout"><div class="rsvp-copy"><p class="eyebrow">{t.rsvpEyebrow}</p><h2 id="rsvp-title">{t.rsvpTitle}</h2><p class="lead">{t.rsvpIntro}</p><p class="privacy">{t.demoNotice}</p><a class="button button-light" href="#rsvp-form">{t.rsvpLink}<Icon name="arrow"/></a></div><div class="form-panel native-panel"><div class="form-heading"><h3>{t.formTitle}</h3><p>{t.formIntro}</p></div><form id="rsvp-form" class="native-form" autocomplete="off" data-demo-only aria-describedby="demo-form-notice"><p id="demo-form-notice" class="field-help">{t.demoNotice}</p><fieldset class="attendance-choices" id="attendance-set"><legend>{t.attendance} *</legend><label><input type="radio" name="attendance" value="yes" required/><span>{t.yes} ♡</span></label><label><input type="radio" name="attendance" value="no"/><span>{t.no}</span></label></fieldset><fieldset id="group-fields" class="group-fields" hidden disabled><label class="field-label" for="party-count">{t.partyCount} *</label><select id="party-count" required aria-describedby="count-help">{Array.from({length:8},(_,i)=><option value={i+1}>{i+1}</option>)}</select><p class="field-help" id="count-help">{t.countHelp}</p><div id="attendees"></div></fieldset><fieldset id="decline-fields" class="group-fields" hidden disabled><label class="field-label" for="decline-name">{t.declineName} *</label><input id="decline-name" autocomplete="off" maxlength="120" required/></fieldset><label class="field-label" for="guest-message">{t.message} · {t.optional}</label><textarea id="guest-message" maxlength="500" rows="3" autocomplete="off"></textarea><button class="button button-primary form-submit" type="submit" disabled>{t.submit} ↗</button><button class="button button-outline form-reset" type="reset">{t.reset}</button><noscript><p class="field-help">{t.noscript}</p></noscript></form><template id="person-template"><fieldset class="person-fields"><legend data-person-title></legend><label class="field-label" data-label="name">{t.name} *</label><input data-field="name" autocomplete="off" maxlength="120" required/><label class="field-label" data-label="meal">{t.menu} *</label><select data-field="meal" required><option value="">{t.choose}</option><option value="adult">{t.adult}</option><option value="child">{t.child}</option></select><label class="field-label" data-label="allergies">{t.allergies} · {t.optional}</label><textarea data-field="allergies" rows="2" maxlength="300" autocomplete="off"></textarea></fieldset></template><div class="form-success" id="form-success" hidden tabindex="-1"><span class="success-heart" aria-hidden="true">♡</span><h3>{t.success}</h3><p>{t.successText}</p><button type="button" class="button button-outline" id="try-again">{t.reset}</button></div></div></div></section>
    <section class="closing container"><Icon name="heart"/><p>{t.closing}</p><span class="script">{t.closingSmall}</span><strong class="couple-signature"><span class="signature-name">Alex</span><span class="signature-amp">&</span><span class="signature-name">Sam</span></strong><time datetime={demoEvent.date}>{t.fullDate}</time></section>
  </main>
  <footer class="site-footer container"><p>{t.footer}</p><button class="footer-access" type="button" data-access><Icon name="access"/>{t.access}</button><a href="#top">{t.top} ↑</a></footer>
  <dialog id="access-dialog" aria-labelledby="access-title"><button class="dialog-close" type="button" data-close aria-label={t.close}><Icon name="close"/></button><p class="eyebrow">{t.access}</p><h2 id="access-title">{t.accessTitle}</h2><p>{t.accessIntro}</p><fieldset><legend>{t.textSize}</legend><div class="text-size-options">{t.sizes.map((label,i)=><label><input type="radio" name="text-size" value={i} checked={i===0}/><span>{label}</span></label>)}</div></fieldset><label class="toggle-row"><span>{t.contrast}</span><input type="checkbox" id="contrast"/></label><label class="toggle-row"><span>{t.motion}</span><input type="checkbox" id="motion"/></label><button class="button button-outline" type="button" id="reset-preferences">{t.resetPreferences}</button><p class="small">{t.preferencesNote}</p><p id="preference-status" class="sr-only" role="status"></p></dialog>
  <dialog id="photo-dialog" class="photo-dialog" aria-labelledby="photo-dialog-title"><div class="lightbox-heading"><h2 id="photo-dialog-title">{t.lightbox}</h2><button class="dialog-close" type="button" data-close aria-label={t.close}><Icon name="close"/></button></div><img id="lightbox-image" width="1440" height="1080" alt=""/><div class="lightbox-controls"><button type="button" id="previous-photo" aria-label={t.previous}><Icon name="left"/></button><p id="photo-counter" role="status"></p><button type="button" id="next-photo" aria-label={t.next}><Icon name="right"/></button></div></dialog>
  <dialog id="map-dialog" aria-labelledby="map-title"><button class="dialog-close" type="button" data-close aria-label={t.close}><Icon name="close"/></button><h2 id="map-title">{t.mapTitle}</h2><p id="map-venue"></p><div class="demo-map-canvas"><svg id="demo-map-art" viewBox="0 0 500 330" role="img" aria-label={t.mapTitle}><rect width="500" height="330" fill="#eee9df"/><path d="M0 70h500M0 260h500M100 0v330M370 0v330" stroke="#fffdf8" stroke-width="28"/><rect x="140" y="110" width="190" height="110" rx="35" fill="#c7d1b9"/><path d="M255 135c-34 0-40 44 0 74 40-30 34-74 0-74Z" fill="#713c49"/><circle cx="255" cy="162" r="9" fill="#fffdf8"/></svg></div><div class="demo-map-controls"><button type="button" class="button button-outline" id="map-out" aria-label={t.zoomOut}>−</button><button type="button" class="button button-outline" id="map-in" aria-label={t.zoomIn}>+</button></div><p class="small">{t.mapNotice}</p></dialog>
  <script>
    import '../scripts/wedding-demo';
  </script>
</body>
</html>
